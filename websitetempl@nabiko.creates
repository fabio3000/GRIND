                    <ellipse cx="48" cy="64" rx="24" ry="10" transform="rotate(-20 48 64)" fill="#5C6BC0" stroke="#4A3B39" stroke-width="3.5"/>
                    <ellipse cx="102" cy="64" rx="24" ry="10" transform="rotate(20 102 64)" fill="#5C6BC0" stroke="#4A3B39" stroke-width="3.5"/>
                    <ellipse cx="56" cy="86" rx="22" ry="9" transform="rotate(-40 56 86)" fill="#7986CB" stroke="#4A3B39" stroke-width="3.5"/>
                    <ellipse cx="94" cy="86" rx="22" ry="9" transform="rotate(40 94 86)" fill="#7986CB" stroke="#4A3B39" stroke-width="3.5"/>
                    <!-- Inner White Petals -->
                    <ellipse cx="64" cy="58" rx="7" ry="15" transform="rotate(-30 64 58)" fill="#FFFFFF" stroke="#4A3B39" stroke-width="2.5"/>
                    <ellipse cx="86" cy="58" rx="7" ry="15" transform="rotate(30 86 58)" fill="#FFFFFF" stroke="#4A3B39" stroke-width="2.5"/>
                    <ellipse cx="75" cy="74" rx="7" ry="15" fill="#FFFFFF" stroke="#4A3B39" stroke-width="2.5"/>
                    <!-- Golden Center -->
                    <circle cx="75" cy="66" r="7" fill="#FFF176" stroke="#4A3B39" stroke-width="2.5"/>
                </svg>`
            },
            {
                id: 'cherry-pouch',
                name: 'Sweet Cherry Drawstring Pouch',
                subtitle: 'Plump berry-red crochet pouch with green leaf tie',
                price: 24.00,
                category: 'patterns',
                badge: '🍒 CHERRY POUCH',
                washiColor: 'bg-sakura',
                bgPattern: 'bg-notebook',
                description: 'Keep your trinkets, dice, headphones, or lip balm safe inside this plump cherry-red crochet drawstring bag! Cinches shut with a cute green leaf.',
                svg: `<svg viewBox="0 0 150 150" class="w-40 h-40">
                    <!-- Green Stem & Leaf Drawstring -->
                    <path d="M68 48 C58 28, 42 32, 46 46" fill="none" stroke="#558B2F" stroke-width="4" stroke-linecap="round"/>
                    <path d="M64 48 C38 42, 30 66, 48 72 C58 74, 64 58, 64 48 Z" fill="#4CAF50" stroke="#4A3B39" stroke-width="3.5" stroke-linejoin="round"/>
                    <!-- Plump Red Cherry Pouch Body -->
                    <path d="M56 48 L94 48 C114 58, 120 96, 102 116 C88 128, 62 128, 48 116 C30 96, 36 58, 56 48 Z" fill="#C62828" stroke="#4A3B39" stroke-width="4" stroke-linejoin="round"/>
                    <!-- Cinched Top Pleats -->
                    <path d="M56 48 Q75 56 94 48" fill="none" stroke="#8E0000" stroke-width="4" stroke-linecap="round"/>
                    <line x1="68" y1="52" x2="64" y2="70" stroke="#8E0000" stroke-width="3" stroke-linecap="round"/>
                    <line x1="82" y1="52" x2="86" y2="70" stroke="#8E0000" stroke-width="3" stroke-linecap="round"/>
                </svg>`
            }
        ];

        // State Variables
        let activeCategory = 'all';
        let searchQuery = '';
        let wishlist = new Set();
        let cart = [
            { id: 'gomu-fruit', name: 'Gomu Gomu no Mi Pouch & Pattern', price: 24.00, qty: 1 }
        ];

        // Custom Bouquet State
        let customBouquet = {
            flowerType: 'blue-lily',
            flowerName: 'Blue Lilies & Forget-Me-Nots',
            flowerPrice: 38,
            wrapColor: '#E1F5FE',
            wrapName: 'Pastel Sky Blue',
            addonType: 'none',
            addonName: 'No Mini Charm',
            addonPrice: 0
        };

        function renderProducts() {
            const grid = document.getElementById('productGrid');
            const filtered = products.filter(p => {
                const matchesCat = activeCategory === 'all' 
                    ? true 
                    : activeCategory === 'wishlist' 
                        ? wishlist.has(p.id) 
                        : p.category === activeCategory;
                const matchesSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
                                      p.subtitle.toLowerCase().includes(searchQuery.toLowerCase());
                return matchesCat && matchesSearch;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full bg-white card-cutout rounded-3xl p-10 text-center space-y-3">
                        <div class="text-4xl">🧶💭</div>
                        <h3 class="font-heading font-bold text-xl">No cuties found in this category!</h3>
                        <p class="text-sm text-cocoa/70">Try another filter or view all products again.</p>
                        <button onclick="setCategory('all')" class="bg-sakura border-2 border-cocoa px-5 py-2 rounded-full font-heading font-bold text-sm">
                            Show All Cuties
                        </button>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map((item, idx) => {
                const isLiked = wishlist.has(item.id);
                const tiltClass = idx % 2 === 0 ? 'hover:-rotate-1' : 'hover:rotate-1';
                return `
                    <article class="bg-white card-cutout rounded-3xl p-5 flex flex-col justify-between relative group ${tiltClass}">
                        <!-- Decorative Top Washi Tape -->
                        <div class="washi-tape ${item.washiColor} -top-3 left-1/2 -translate-x-1/2 ${idx % 2 === 0 ? '-rotate-2' : 'rotate-2'}"></div>

                        <div>
                            <!-- Top Row: Badge & Wishlist Heart -->
                            <div class="flex items-center justify-between mb-3 relative z-10">
                                <span class="bg-cream border-2 border-cocoa px-3 py-0.5 rounded-full font-hand text-[11px] font-bold shadow-xs">
                                    ${item.badge}
                                </span>
                                <button onclick="toggleWishlist('${item.id}')" aria-label="Favorite" class="w-9 h-9 rounded-full ${isLiked ? 'bg-sakura text-sakuraDark' : 'bg-white text-cocoa/40'} border-2 border-cocoa flex items-center justify-center hover:scale-110 transition-transform">
                                    <i class="ph-fill ph-heart text-lg"></i>
                                </button>
                            </div>

                            <!-- Cutout Illustration Frame -->
                            <div onclick="quickOpenProduct('${item.id}')" class="cursor-pointer ${item.bgPattern} border-2 border-cocoa rounded-2xl h-52 flex items-center justify-center relative overflow-hidden mb-4">
                                <div class="sticker-cutout">
                                    ${item.svg}
                                </div>
                                <span class="absolute bottom-2 right-2 bg-white/90 border border-cocoa px-2.5 py-0.5 rounded-full text-[11px] font-hand opacity-0 group-hover:opacity-100 transition-opacity">
                                    🔍 View details
                                </span>
                            </div>

                            <!-- Title & Subtitle -->
                            <h3 onclick="quickOpenProduct('${item.id}')" class="cursor-pointer font-heading font-bold text-lg text-cocoa group-hover:text-sakuraDark transition-colors">
                                ${item.name}
                            </h3>
                            <p class="text-xs text-cocoa/75 mt-0.5 line-clamp-2">
                                ${item.subtitle}
                            </p>
                        </div>

                        <!-- Price & Add Button -->
                        <div class="pt-4 mt-4 border-t-2 border-dashed border-cocoa/15 flex items-center justify-between">
                            <div>
                                <span class="text-[11px] font-hand text-cocoa/60 block">Handmade Price</span>
                                <span class="font-heading font-bold text-xl text-cocoa">€${item.price.toFixed(2)}</span>
                            </div>
                            <button onclick="addToCart('${item.id}')" class="bg-sakura hover:bg-matcha text-cocoa font-heading font-bold text-xs sm:text-sm px-4 py-2.5 rounded-xl border-2 border-cocoa shadow-[2px_3px_0px_#4A3B39] active:translate-y-0.5 transition-all flex items-center gap-1.5">
                                <i class="ph-bold ph-plus"></i>
                                <span>Add to Cart</span>
                            </button>
                        </div>
                    </article>
                `;
            }).join('');
        }

        function setCategory(cat) {
            playPopSound(520);
            activeCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if (btn.dataset.cat === cat) {
                    btn.className = 'cat-btn bg-cocoa text-white border-2 border-cocoa px-4 sm:px-5 py-2 rounded-2xl font-heading font-semibold text-xs sm:text-sm shadow-[3px_3px_0px_#E56B8F] shrink-0 transition-transform';
                } else {
                    btn.className = 'cat-btn bg-white hover:bg-sakura/40 text-cocoa border-2 border-cocoa px-4 sm:px-5 py-2 rounded-2xl font-heading font-semibold text-xs sm:text-sm shadow-[3px_3px_0px_#4A3B39] shrink-0 transition-transform';
                }
            });
            renderProducts();
        }

        function handleSearch(val) {
            searchQuery = val;
            renderProducts();
        }

        function toggleWishlist(id) {
            playPopSound(700);
            if (wishlist.has(id)) {
                wishlist.delete(id);
                showToast('Removed from your wishlist');
            } else {
                wishlist.add(id);
                showToast('💖 Added to your wishlist!');
            }
            document.getElementById('wishlistBadge').textContent = wishlist.size;
            renderProducts();
        }

        function filterByWishlist() {
            if (wishlist.size === 0) {
                showToast('💖 Click the little heart on a product first!');
                return;
            }
            activeCategory = 'wishlist';
            renderProducts();
            document.getElementById('shop').scrollIntoView({ behavior: 'smooth' });
        }

        // Custom Bouquet Live Preview Renderer
        function renderBouquetPreview() {
            const container = document.getElementById('bouquetPreviewContainer');
            const summary = document.getElementById('customSummaryText');
            const priceEl = document.getElementById('customBouquetPrice');

            let flowersSvg = '';
            if (customBouquet.flowerType === 'blue-lily') {
                flowersSvg = `
                    <circle cx="54" cy="48" r="15" fill="#64B5F6" stroke="#4A3B39" stroke-width="3.5"/>
                    <circle cx="54" cy="48" r="5" fill="#FFF176"/>
                    <circle cx="96" cy="48" r="15" fill="#7986CB" stroke="#4A3B39" stroke-width="3.5"/>
                    <circle cx="96" cy="48" r="5" fill="#FFF176"/>
                    <circle cx="75" cy="36" r="17" fill="#FFF9C4" stroke="#4A3B39" stroke-width="3.5"/>
                    <circle cx="75" cy="36" r="6" fill="#FFB74D"/>
                `;
            } else if (customBouquet.flowerType === 'pink-peony') {
                flowersSvg = `
                    <circle cx="55" cy="50" r="13" fill="#F8BBD0" stroke="#4A3B39" stroke-width="3.5"/>
                    <circle cx="95" cy="50" r="13" fill="#F8BBD0" stroke="#4A3B39" stroke-width="3.5"/>
                    <circle cx="75" cy="40" r="21" fill="#F48FB1" stroke="#4A3B39" stroke-width="3.5"/>
                    <circle cx="75" cy="40" r="12" fill="#FCE4EC" stroke="#4A3B39" stroke-width="2.5" stroke-dasharray="5 3"/>
                `;
            } else if (customBouquet.flowerType === 'glaze-lily') {
                flowersSvg = `
                    <circle cx="54" cy="48" r="14" fill="#42A5F5" stroke="#4A3B39" stroke-width="3.5"/>
                    <circle cx="96" cy="48" r="14" fill="#5C6BC0" stroke="#4A3B39" stroke-width="3.5"/>
                    <circle cx="75" cy="36" r="17" fill="#FFFFFF" stroke="#4A3B39" stroke-width="3.5"/>
                    <circle cx="75" cy="36" r="6" fill="#FFF176"/>
                `;
            } else {
                flowersSvg = `
                    <ellipse cx="54" cy="46" rx="12" ry="16" fill="#BA68C8" stroke="#4A3B39" stroke-width="3.5"/>
                    <ellipse cx="96" cy="46" rx="12" ry="16" fill="#9575CD" stroke="#4A3B39" stroke-width="3.5"/>
                    <circle cx="75" cy="36" r="16" fill="#E1BEE7" stroke="#4A3B39" stroke-width="3.5"/>
                    <circle cx="75" cy="36" r="6" fill="#FFF176"/>
                `;
            }

            let addonBadge = '';
            if (customBouquet.addonType === 'bee') {
                addonBadge = `<circle cx="95" cy="24" r="10" fill="#FFD54F" stroke="#4A3B39" stroke-width="3"/><text x="89" y="28" font-size="12">🐝</text>`;
            } else if (customBouquet.addonType === 'frog') {
                addonBadge = `<circle cx="95" cy="24" r="10" fill="#AED581" stroke="#4A3B39" stroke-width="3"/><text x="89" y="28" font-size="12">🐸</text>`;
            }

            container.innerHTML = `
                <svg viewBox="0 0 150 150" class="w-full h-full">
                    <polygon points="32,62 118,62 90,136 60,136" fill="${customBouquet.wrapColor}" stroke="#4A3B39" stroke-width="4" stroke-linejoin="round"/>
                    <polygon points="44,55 106,55 92,116 58,116" fill="#FFFFFF" stroke="#4A3B39" stroke-width="3" stroke-linejoin="round"/>
                    <path d="M75 68 L56 46 M75 68 L94 46 M75 68 L75 36" stroke="#66BB6A" stroke-width="4" stroke-linecap="round"/>
                    ${flowersSvg}
                    ${addonBadge}
                    <path d="M62 114 C44 104, 44 126, 68 117 C94 126, 94 104, 75 114" fill="#F8BBD0" stroke="#4A3B39" stroke-width="3.5"/>
                </svg>
            `;

            const total = customBouquet.flowerPrice + customBouquet.addonPrice;
            summary.textContent = `${customBouquet.flowerName} • ${customBouquet.wrapName} ${customBouquet.addonType !== 'none' ? '• ' + customBouquet.addonName : ''}`;
            priceEl.textContent = `€${total.toFixed(2)}`;
        }

        function updateBouquet(part, val, label, price = 0) {
            playPopSound(620);
            if (part === 'flower') {
                customBouquet.flowerType = val;
                customBouquet.flowerName = label;
                customBouquet.flowerPrice = price;
            } else if (part === 'wrap') {
                customBouquet.wrapColor = val;
                customBouquet.wrapName = label;
            } else if (part === 'addon') {
                customBouquet.addonType = val;
                customBouquet.addonName = label;
                customBouquet.addonPrice = price;
            }
            renderBouquetPreview();
        }

        function addCustomBouquetToCart() {
            const total = customBouquet.flowerPrice + customBouquet.addonPrice;
            const customItem = {
                id: 'custom-bouquet-' + Date.now(),
                name: `Custom Bouquet (${customBouquet.flowerName})`,
                price: total,
                qty: 1
            };
            cart.push(customItem);
            playPopSound(740);
            updateCartUI();
            toggleCart(true);
            showToast('💐 Your Custom Crochet Bouquet was added to the cart!');
        }

        // Yarn vs Finish Interactive Card
        let yarnTransformed = false;
        function toggleYarnMagic() {
            playPopSound(680);
            yarnTransformed = !yarnTransformed;
            const view = document.getElementById('yarnStateView');
            if (yarnTransformed) {
                view.innerHTML = `
                    <div class="flex justify-center gap-3 text-4xl my-2">
                        <span class="animate-bounce">💐</span>
                        <span class="animate-bounce" style="animation-delay:0.1s">🌺</span>
                        <span class="animate-bounce" style="animation-delay:0.2s">✨</span>
                    </div>
                    <p class="font-hand text-sm font-bold text-sakuraDark mt-2">Tadaaa! A finished Forever Peony Bouquet! 🌸</p>
                    <span class="inline-block mt-2 text-xs bg-matcha border border-cocoa px-3 py-1 rounded-full font-heading font-semibold">
                        🔄 Click to rewind
                    </span>
                `;
            } else {
                view.innerHTML = `
                    <div class="flex justify-center gap-3 text-4xl my-2">
                        <span class="animate-bounce">🧶</span>
                        <span class="animate-bounce" style="animation-delay:0.15s">🌸</span>
                        <span class="animate-bounce" style="animation-delay:0.3s">🥬</span>
                    </div>
                    <p class="font-hand text-sm font-bold text-cocoa mt-2">5 soft pastel yarn balls...</p>
                    <span class="inline-block mt-2 text-xs bg-butter border border-cocoa px-3 py-1 rounded-full font-heading font-semibold">
                        👉 Click to transform!
                    </span>
                `;
            }
        }

        // Modal & Cart Logic
        function quickOpenProduct(id) {
            playPopSound(600);
            const item = products.find(p => p.id === id);
            if (!item) return;
            const modal = document.getElementById('productModal');
            const content = document.getElementById('productModalContent');

            content.innerHTML = `
                <div class="flex flex-col items-center text-center space-y-4">
                    <span class="bg-butter border-2 border-cocoa px-3 py-0.5 rounded-full font-hand text-xs font-bold">
                        ${item.badge}
                    </span>
                    <div class="${item.bgPattern} border-2 border-cocoa rounded-3xl w-full py-6 flex items-center justify-center">
                        <div class="sticker-cutout">${item.svg}</div>
                    </div>
                    <h3 class="font-heading font-bold text-2xl text-cocoa">${item.name}</h3>
                    <p class="text-sm text-cocoa/80 leading-relaxed">${item.description}</p>
                    <div class="w-full pt-3 flex items-center justify-between border-t-2 border-dashed border-cocoa/20">
                        <span class="font-heading font-bold text-2xl text-cocoa">€${item.price.toFixed(2)}</span>
                        <button onclick="addToCart('${item.id}'); closeProductModal();" class="bg-sakura hover:bg-matcha text-cocoa font-heading font-bold px-6 py-3 rounded-2xl card-cutout">
                            🧶 Adopt Now
                        </button>
                    </div>
                </div>
            `;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeProductModal() {
            const modal = document.getElementById('productModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function addToCart(productId) {
            playPopSound(720);
            const prod = products.find(p => p.id === productId);
            if (!prod) return;

            const existing = cart.find(item => item.id === productId);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ id: prod.id, name: prod.name, price: prod.price, qty: 1 });
            }
            updateCartUI();
            showToast(`🧶 "${prod.name}" added to cart!`);
        }

        function changeQty(id, delta) {
            playPopSound(540);
            const idx = cart.findIndex(i => i.id === id);
            if (idx === -1) return;
            cart[idx].qty += delta;
            if (cart[idx].qty <= 0) {
                cart.splice(idx, 1);
            }
            updateCartUI();
        }

        function updateCartUI() {
            const countBadge = document.getElementById('cartCountBadge');
            const container = document.getElementById('cartItemsContainer');
            const totalEl = document.getElementById('cartTotalPrice');
            const shipText = document.getElementById('freeShippingText');
            const shipBar = document.getElementById('freeShippingBar');

            const totalItems = cart.reduce((sum, i) => sum + i.qty, 0);
            const totalPrice = cart.reduce((sum, i) => sum + i.price * i.qty, 0);

            countBadge.textContent = totalItems;
            totalEl.textContent = `€${totalPrice.toFixed(2)}`;

            // Free shipping threshold = 60 EUR
            const pct = Math.min(100, (totalPrice / 60) * 100);
            shipBar.style.width = `${pct}%`;
            if (totalPrice >= 60) {
                shipText.innerHTML = '🎉 <strong>Yay!</strong> You unlocked Free Shipping + Free Sticker Pack!';
            } else {
                const diff = (60 - totalPrice).toFixed(2);
                shipText.innerHTML = `✨ Only <strong>€${diff}</strong> away from Free Shipping!`;
            }

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-10 space-y-2">
                        <div class="text-4xl">🧺💭</div>
                        <p class="font-heading font-bold text-base">Your basket is empty!</p>
                        <p class="text-xs text-cocoa/70">Pick some fluffy crochet cuties to adopt.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = cart.map(item => `
                <div class="bg-white border-2 border-cocoa rounded-2xl p-3.5 flex items-center justify-between gap-3 shadow-[2px_3px_0px_#4A3B39]">
                    <div>
                        <h4 class="font-heading font-bold text-sm text-cocoa">${item.name}</h4>
                        <span class="text-xs font-semibold text-sakuraDark">€${(item.price * item.qty).toFixed(2)}</span>
                    </div>
                    <div class="flex items-center gap-2 bg-cream border-2 border-cocoa rounded-full px-2 py-0.5">
                        <button onclick="changeQty('${item.id}', -1)" class="w-5 h-5 font-bold text-xs">-</button>
                        <span class="font-heading font-bold text-xs">${item.qty}</span>
                        <button onclick="changeQty('${item.id}', 1)" class="w-5 h-5 font-bold text-xs">+</button>
                    </div>
                </div>
            `).join('');
        }

        function toggleCart(open) {
            const drawer = document.getElementById('cartDrawer');
            const backdrop = document.getElementById('cartDrawerBackdrop');
            if (open) {
                backdrop.classList.remove('hidden');
                drawer.classList.remove('translate-x-full');
            } else {
                backdrop.classList.add('hidden');
                drawer.classList.add('translate-x-full');
            }
        }

        function handleCheckout() {
            if (cart.length === 0) {
                showToast('🧺 Add a cutie to your cart first!');
                return;
            }
            playPopSound(820);
            cart = [];
            updateCartUI();
            toggleCart(false);
            showToast('🎉 Thank you for your order at @nabiko.creates! Getting my crochet hook ready! 💕');
        }

        // Toast Helper
        let toastTimeout = null;
        function showToast(msg) {
            const box = document.getElementById('toastBox');
            document.getElementById('toastMessage').textContent = msg;
            box.classList.remove('opacity-0', 'translate-y-4');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                box.classList.add('opacity-0', 'translate-y-4');
            }, 2800);
        }

        // Initialize Shop on Load
        window.onload = function () {
            renderProducts();
            renderBouquetPreview();
            updateCartUI();
        };
    </script>
</body>
</html>
