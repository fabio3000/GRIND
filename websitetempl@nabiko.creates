    <!-- Custom Cute Toast Notification -->
    <div id="toastBox" class="fixed bottom-5 right-5 z-50 pointer-events-none opacity-0 translate-y-4 transition-all duration-300">
        <div class="bg-white border-2 border-cocoa rounded-2xl px-4 py-3 shadow-[4px_4px_0px_#4A3B39] flex items-center gap-2.5 font-heading font-semibold text-sm text-cocoa">
            <span class="text-lg">🌸</span>
            <span id="toastMessage">Added!</span>
        </div>
    </div>

    <script>
        // Sound Effects using Web Audio API (No external files needed)
        let soundEnabled = true;
        let audioCtx = null;

        function playPopSound(freq = 580) {
            if (!soundEnabled) return;
            try {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(freq * 1.45, audioCtx.currentTime + 0.09);
                gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.09);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.09);
            } catch (e) {
                // Ignore if browser blocks audio before interaction
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('soundIcon');
            icon.className = soundEnabled ? 'ph-fill ph-speaker-high text-lg text-cocoa' : 'ph-fill ph-speaker-slash text-lg text-cocoa/50';
            if (soundEnabled) playPopSound(660);
            showToast(soundEnabled ? '🔊 Cute sounds enabled!' : '🔇 Sounds muted');
        }

        // Complete Product Data matching all items from both Instagram screenshots
        const products = [
            {
                id: 'gomu-fruit',
                name: 'Gomu Gomu no Mi Pouch & Pattern',
                subtitle: 'One Piece Devil Fruit (Finished Pouch or PDF)',
                price: 24.00,
                category: 'patterns',
                badge: '🍇 PATTERN RELEASE',
                washiColor: 'bg-taro',
                bgPattern: 'bg-gingham-purple',
                description: 'Inspired by One Piece! Available as a handmade crochet AirPods/mini pouch featuring the iconic swirls, or as a detailed step-by-step PDF crochet pattern.',
                svg: `<svg viewBox="0 0 140 140" class="w-40 h-40">
                    <path d="M70 30 C70 14, 96 14, 100 28 C104 37, 88 38, 86 30" fill="none" stroke="#558B2F" stroke-width="10" stroke-linecap="round"/>
                    <circle cx="70" cy="82" r="44" fill="#7E57C2" stroke="#4A3B39" stroke-width="4"/>
                    <path d="M45 65 C38 55, 58 50, 56 64 C55 72, 43 72, 47 63" fill="none" stroke="#D1C4E9" stroke-width="4.5" stroke-linecap="round"/>
                    <path d="M75 62 C68 52, 88 48, 86 62 C85 70, 73 70, 77 61" fill="none" stroke="#D1C4E9" stroke-width="4.5" stroke-linecap="round"/>
